+            </div>
+            <div class="bg-slate-50 rounded p-4">
+                <p class="text-xs text-slate-400 mb-1">Status</p>
+                <p class="font-semibold
+                    {% if ticket.status == 'waiting' %}text-amber-500
+                    {% elif ticket.status == 'serving' %}text-green-500
+                    {% elif ticket.status == 'completed' %}text-slate-400
+                    {% else %}text-red-500{% endif %}">
+                    {{ ticket.get_status_display }}
+                </p>
+            </div>
+        </div>
+
+        <!-- Waiting Ahead -->
+        {% if ticket.status == 'waiting' %}
+            <div class="bg-amber-50 rounded-lg p-4 mb-6">
+                <p class="text-amber-700 font-semibold">
+                    {{ waiting_ahead }} person{{ waiting_ahead|pluralize }}
+                    ahead of you
+                </p>
+            </div>
+        {% elif ticket.status == 'serving' %}
+            <div class="bg-green-50 rounded-lg p-4 mb-6">
+                <p class="text-green-700 font-semibold">
+                    🎉 It's your turn! Please proceed to
+                    Counter {{ ticket.counter.number }}
+                </p>
+            </div>
+        {% elif ticket.status == 'completed' %}
+            <div class="bg-slate-50 rounded-lg p-4 mb-6">
+                <p class="text-slate-500">
+                    Your transaction has been completed. Thank you!
+                </p>
+            </div>
+        {% elif ticket.status == 'no_show' %}
+            <div class="bg-red-50 rounded-lg p-4 mb-6">
+                <p class="text-red-500">
+                    Your ticket was marked as no show.
+                </p>
+            </div>
+        {% endif %}
+
+        <div class="flex gap-3 justify-center">
+            <a href="{% url 'home' %}"
+               class="bg-slate-200 text-slate-700 px-4 py-2 rounded hover:bg-slate-300 transition">
+                Back to Home
+            </a>
+            {% if ticket.status == 'waiting' %}
+                <a href="{% url 'ticket-status' ticket.pk %}"
+                   class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">
+                    Refresh Status
+                </a>
+            {% endif %}
+        </div>
+    </div>
+{% endblock %}
