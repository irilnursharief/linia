+{% load static %}
+<!DOCTYPE html>
+<html lang="en">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Linia - Queue System</title>
+    <script src="https://cdn.tailwindcss.com"></script>
+    <link rel="stylesheet" href="{% static 'css/style.css' %}">
+    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
+</head>
+<body class="bg-slate-100 text-slate-800 min-h-screen">
+    <nav class="bg-blue-600 px-8 py-4 flex justify-between items-center">
+        <div class="text-white text-xl font-bold">🎫 Linia</div>
+        <div class="flex items-center gap-4 text-sm">
+            {% if request.user.is_authenticated %}
+                <span class="text-white">👋 {{ request.user.username }}</span>
+                <form method="POST" action="{% url 'logout' %}">
+                    {% csrf_token %}
+                    <button type="submit" class="border border-white text-white px-3 py-1 rounded hover:bg-white hover:text-blue-600 transition">
+                        Logout
+                    </button>
+                </form>
+            {% else %}
+                <a href="{% url 'login' %}" class="text-white hover:underline">Login</a>
+            {% endif %}
+        </div>
+    </nav>
+    <div class="max-w-4xl mx-auto mt-10 px-4">
+        {% if messages %}
+            {% for message in messages %}
+                <div class="mb-4 p-4 rounded-lg
+                    {% if message.tags  == 'success' %}bg-green-100 text-green-800
+                    {% elif message.tags == 'error' %}bg-red-100 text-red-800
+                    {% else %}bg-blue-100 text-blue-800{% endif %}">
+                    {{ message }}
+                </div>
+            {% endfor %}
+        {% endif %}
+        {% block content %}
+        {% endblock %}
+    </div>
+</body>
+</html>
