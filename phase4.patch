+{% extends 'base.html' %}
+
+{% block content %}
+    <div class="mb-6">
+        <h1 class="text-2xl font-bold">Counter Dashboard</h1>
+        {% if counter %}
+            <p class="text-slate-500 mt-1">Counter {{ counter.number }} — {{ counter.service.name }}</p>
+        {% else %}
+            <p class="text-red-500 mt-1">No open counter assigned to you.</p>
+        {% endif %}
+    </div>
+
+    {% if counter %}
+        <!-- Current Ticket -->
+        <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
+            <h2 class="text-lg font-bold mb-4">Now Serving</h2>
+            {% if current_ticket %}
+                <div class="text-center">
+                    <p class="text-5xl font-bold text-blue-600 mb-2">
+                        {{ current_ticket.ticket_number }}
+                    </p>
+                    <p class="text-slate-500">{{ current_ticket.get_client_type_display }}</p>
+                </div>
+                <div class="flex gap-3 mt-6 justify-center">
+                    <form method="POST" action="{% url 'counter-recall' %}">
+                        {% csrf_token %}
+                        <button type="submit" class="bg-amber-400 text-white px-4 py-2 rounded hover:bg-amber-500 transition">
+                            Recall
+                        </button>
+                    </form>
+                    <form method="POST" action="{% url 'counter-no-show' %}">
+                        {% csrf_token %}
+                        <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 transition">
+                            No Show
+                        </button>
+                    </form>
+                    <form method="POST" action="{% url 'counter-complete' %}">
+                        {% csrf_token %}
+                        <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600 transition">
+                            Complete
+                        </button>
+                    </form>
+                </div>
+            {% else %}
+                <p class="text-slate-400 text-center">No ticket currently being served.</p>
+            {% endif %}
+        </div>
+
+        <!-- Call Next -->
+        <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
+            <div class="flex justify-between items-center">
+                <div>
+                    <h2 class="text-lg font-bold">Waiting Queue</h2>
+                    <p class="text-slate-500 text-sm mt-1">
+                        {{ waiting_tickets.count }} ticket{{ waiting_tickets.count|pluralize }} waiting
+                    </p>
+                </div>
+                <form method="POST" action="{% url 'counter-call-next' %}">
+                    {% csrf_token %}
+                    <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition font-semibold">
+                        Call Next
+                    </button>
+                </form>
+            </div>
+
+            {% if waiting_tickets %}
+                <div class="mt-4 space-y-2">
+                    {% for ticket in waiting_tickets %}
+                        <div class="flex justify-between items-center p-3 bg-slate-50 rounded">
+                            <span class="font-semibold">{{ ticket.ticket_number }}</span>
+                            <span class="text-sm text-slate-500">{{ ticket.get_client_type_display }}</span>
+                        </div>
+                    {% endfor %}
+                </div>
+            {% endif %}
+        </div>
+    {% endif %}
+{% endblock %}
